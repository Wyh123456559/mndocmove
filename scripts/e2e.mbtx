import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/process",
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
}

async fn capture(args : Array[String], expected : Int) -> String {
  let (code, out, err) = @process.collect_output("moon", args)
  if code != expected {
    println(out.text())
    println(err.text())
    abort("unexpected process exit: " + code.to_string())
  }
  // MSVC's text-mode stdout translates LF to CRLF. Normalize that transport
  // layer for report assertions; exported/source file bytes stay unmodified.
  out.text().replace_all(old="\r\n", new="\n")
}

async fn invoke(args : Array[String], expected : Int) -> Unit {
  ignore(capture(args, expected))
}

async fn main {
  let target = @env.args().last().unwrap_or("wasm")
  if target != "wasm" && target != "native" { abort("Use: moon run scripts/e2e.mbtx -- wasm|native") }
  let tmp = @fs.tmpdir(prefix="mndocmove-e2e-")
  let plan = tmp + "/plan.json"
  let output = tmp + "/export"
  let prefix = ["run", "cmd/main", "--target", target, "--target-dir", tmp + "/build", "--deny-warn", "--"]
  let original = @fs.read_file("examples/vscode/tree/README.md").text()
  let original_asset = @fs.read_file("examples/vscode/tree/example.mjs").binary()
  invoke(prefix + ["plan", "examples/vscode/tree", "examples/vscode/moves.json", plan], 0)
  let review = capture(prefix + ["review", plan, "1"], 0)
  assert_true(review.contains("--- \"README.md\"\n+++ \"manual/README.md\""))
  assert_true(review.contains("[example.mjs](../samples/example.mjs)"))
  assert_true(review.contains("[opaque asset]"))
  invoke(prefix + ["review", plan, "21"], 1)
  invoke(prefix + ["review", plan, "invalid"], 1)
  invoke(prefix + ["replay", "examples/vscode/tree", plan, output], 0)
  let expected = original.replace(old="[example.mjs](./example.mjs)", new="[example.mjs](../samples/example.mjs)")
  assert_true(expected != original)
  assert_eq(@fs.read_file(output + "/manual/README.md").text(), expected)
  assert_eq(@fs.read_file(output + "/samples/example.mjs").binary(), original_asset)
  // Exclusive output creation: replay cannot overwrite a completed export.
  invoke(prefix + ["replay", "examples/vscode/tree", plan, output], 1)
  let source = tmp + "/changed"
  @fs.mkdir(source)
  @fs.write_file(source + "/README.md", @utf8.encode(original + "changed"))
  @fs.write_file(source + "/example.mjs", @fs.read_file("examples/vscode/tree/example.mjs"))
  invoke(prefix + ["replay", source, plan, tmp + "/stale"], 1)
  assert_true(!@fs.exists(tmp + "/stale"))
  invoke(prefix + ["replay", "examples/vscode/tree", plan, "examples/vscode/tree/should-not-exist"], 1)
  assert_true(!@fs.exists("examples/vscode/tree/should-not-exist"))
  invoke(prefix + ["plan", "examples/vscode/tree", "examples/vscode/moves.json", "examples/vscode/tree/should-not-exist.json"], 1)
  assert_true(!@fs.exists("examples/vscode/tree/should-not-exist.json"))
  @fs.mkdir(source + "/empty")
  invoke(prefix + ["plan", source, "examples/vscode/moves.json", tmp + "/empty-plan.json"], 1)
  assert_true(!@fs.exists(tmp + "/empty-plan.json"))
  assert_eq(@fs.read_file("examples/vscode/tree/README.md").text(), original)
  assert_eq(@fs.read_file("examples/vscode/tree/example.mjs").binary(), original_asset)
  invoke(prefix + ["plan"], 2)
  let html_plan = tmp + "/html-plan.json"
  let html_output = tmp + "/html-export"
  let html_source = @fs.read_file("examples/bat/tree/header.md").text()
  let logo = @fs.read_file("examples/bat/tree/doc/logo-header.svg").binary()
  invoke(prefix + ["plan", "examples/bat/tree", "examples/bat/moves.json", tmp + "/refused-html.json"], 1)
  assert_true(!@fs.exists(tmp + "/refused-html.json"))
  invoke(prefix + ["plan", "examples/bat/tree", "examples/bat/moves.json", html_plan, "--static-html"], 0)
  let html_review = capture(prefix + ["review", html_plan], 0)
  assert_true(html_review.contains("src=\"../art/logo-header.svg\""))
  invoke(prefix + ["replay", "examples/bat/tree", html_plan, html_output], 0)
  assert_eq(@fs.read_file(html_output + "/manual/header.md").text(), html_source.replace(old="src=\"doc/logo-header.svg\"", new="src=\"../art/logo-header.svg\""))
  assert_eq(@fs.read_file(html_output + "/art/logo-header.svg").binary(), logo)
  assert_eq(@fs.read_file("examples/bat/tree/header.md").text(), html_source)
  // A valid abstract path that the host filesystem cannot create forces an
  // actual write failure after staging starts (single component > 255 bytes).
  let long_component = StringBuilder()
  for _ in 0..<300 { long_component.write_char('x') }
  let fault_moves = tmp + "/fault-moves.json"
  let fault_plan = tmp + "/fault-plan.json"
  @fs.write_file(fault_moves, "[[\"example.mjs\",\"" + long_component.to_string() + "/example.mjs\"]]", create_mode=CreateNew)
  invoke(prefix + ["plan", "examples/vscode/tree", fault_moves, fault_plan], 0)
  let recovery_target = tmp + "/recoverable-output"
  let failure = capture(prefix + ["replay", "examples/vscode/tree", fault_plan, recovery_target], 1)
  assert_true(failure.contains("ExportFailed:"))
  assert_true(failure.contains(".mndocmove-stage-"))
  assert_true(!@fs.exists(recovery_target))
  let retained = @fs.readdir(tmp, include_hidden=true).filter(fn(name) { name.has_prefix(".mndocmove-stage-") })
  assert_eq(retained.length(), 1)
  assert_true(@fs.exists(tmp + "/" + retained[0] + "/.mndocmove-incomplete"))
  assert_true(@fs.exists(tmp + "/" + retained[0] + "/tree"))
  // The failed final path is still usable with a corrected, verified plan.
  invoke(prefix + ["replay", "examples/vscode/tree", plan, recovery_target], 0)
  assert_eq(@fs.read_file(recovery_target + "/manual/README.md").text(), expected)
  assert_eq(@fs.read_file(recovery_target + "/samples/example.mjs").binary(), original_asset)
  assert_eq(@fs.readdir(tmp, include_hidden=true).filter(fn(name) { name.has_prefix(".mndocmove-stage-") }).length(), 1)
  assert_eq(@fs.read_file("examples/vscode/tree/README.md").text(), original)
  assert_eq(@fs.read_file("examples/vscode/tree/example.mjs").binary(), original_asset)
  // Restoration uses the saved original bytes, not a reverse rewrite. It
  // exports a new tree and refuses both existing paths and later edits.
  let restored = tmp + "/restored"
  invoke(prefix + ["restore", output, plan, restored], 0)
  assert_eq(@fs.readdir(restored, sort=true), ["README.md", "example.mjs"])
  assert_eq(@fs.read_file(restored + "/README.md").binary(), @fs.read_file("examples/vscode/tree/README.md").binary())
  assert_eq(@fs.read_file(restored + "/example.mjs").binary(), original_asset)
  invoke(prefix + ["restore", output, plan, restored], 1)
  invoke(prefix + ["restore", output, plan, output + "/inside"], 1)
  assert_true(!@fs.exists(output + "/inside"))
  let edited = tmp + "/edited-result"
  @fs.mkdir(edited + "/manual", recursive=true)
  @fs.mkdir(edited + "/samples")
  @fs.write_file(edited + "/manual/README.md", expected + "Later edits\n")
  @fs.write_file(edited + "/samples/example.mjs", original_asset)
  let retry_restore = tmp + "/retry-restore"
  let stale_restore = capture(prefix + ["restore", edited, plan, retry_restore], 1)
  assert_true(stale_restore.contains("RestoreMismatch: manual/README.md:"))
  assert_true(!@fs.exists(retry_restore))
  assert_eq(@fs.read_file(edited + "/manual/README.md").text(), expected + "Later edits\n")
  invoke(prefix + ["restore", output, plan, retry_restore], 0)
  assert_eq(@fs.read_file(retry_restore + "/README.md").text(), original)
  assert_eq(@fs.read_file(retry_restore + "/example.mjs").binary(), original_asset)
  let html_restored = tmp + "/html-restored"
  invoke(prefix + ["restore", html_output, html_plan, html_restored], 0)
  assert_eq(@fs.read_file(html_restored + "/header.md").text(), html_source)
  assert_eq(@fs.read_file(html_restored + "/doc/logo-header.svg").binary(), logo)
  assert_eq(@fs.read_file(output + "/manual/README.md").text(), expected)
  assert_eq(@fs.read_file(output + "/samples/example.mjs").binary(), original_asset)
  // An authored navigation page surrounds the unmodified Microsoft fixture.
  // Its ../ link names the inventory root, even after the whole guide moves.
  let navigation_root = tmp + "/navigation-source"
  @fs.mkdir(navigation_root + "/guide", recursive=true)
  @fs.write_file(navigation_root + "/guide/README.md", @fs.read_file("examples/vscode/tree/README.md"))
  @fs.write_file(navigation_root + "/guide/example.mjs", original_asset)
  let navigation = "# Navigation\r\n[Documentation root](../?view=tree#docs)\r\n[Guide](README.md)\r\n"
  @fs.write_file(navigation_root + "/guide/NAV.md", navigation)
  let navigation_moves = tmp + "/navigation-moves.json"
  let navigation_plan = tmp + "/navigation-plan.json"
  let navigation_output = tmp + "/navigation-export"
  @fs.write_file(navigation_moves, "[[\"guide\",\"manual/deep\"]]")
  invoke(prefix + ["plan", navigation_root, navigation_moves, navigation_plan], 0)
  let navigation_review = capture(prefix + ["review", navigation_plan], 0)
  assert_true(navigation_review.contains("+[Documentation root](../../?view=tree#docs)"))
  invoke(prefix + ["replay", navigation_root, navigation_plan, navigation_output], 0)
  assert_eq(@fs.read_file(navigation_output + "/manual/deep/NAV.md").text(), navigation.replace(old="../?", new="../../?"))
  assert_eq(@fs.read_file(navigation_output + "/manual/deep/README.md").binary(), @fs.read_file("examples/vscode/tree/README.md").binary())
  assert_eq(@fs.read_file(navigation_output + "/manual/deep/example.mjs").binary(), original_asset)
  invoke(prefix + ["restore", navigation_output, navigation_plan, tmp + "/navigation-restored"], 0)
  assert_eq(@fs.read_file(tmp + "/navigation-restored/guide/NAV.md").text(), navigation)
  assert_eq(@fs.read_file(navigation_root + "/guide/NAV.md").text(), navigation)
  let responsive_plan = tmp + "/responsive-plan.json"
  let responsive_output = tmp + "/responsive-export"
  let responsive_source = @fs.read_file("examples/svelte/tree/header.md").text()
  let width_source = @fs.read_file("examples/svelte/tree/width.md").binary()
  let banner = @fs.read_file("examples/svelte/tree/assets/banner.png").binary()
  let dark_banner = @fs.read_file("examples/svelte/tree/assets/banner_dark.png").binary()
  invoke(prefix + ["plan", "examples/svelte/tree", "examples/svelte/moves.json", tmp + "/refused-responsive.json"], 1)
  assert_true(!@fs.exists(tmp + "/refused-responsive.json"))
  invoke(prefix + ["plan", "examples/svelte/tree", "examples/svelte/moves.json", responsive_plan, "--static-html"], 0)
  let responsive_review = capture(prefix + ["review", responsive_plan], 0)
  assert_true(responsive_review.contains("srcset=\"../art/banner_dark.png\""))
  assert_true(responsive_review.contains("src=\"../art/banner.png\""))
  invoke(prefix + ["replay", "examples/svelte/tree", responsive_plan, responsive_output], 0)
  assert_eq(@fs.read_file(responsive_output + "/manual/header.md").text(), responsive_source.replace_all(old="assets/", new="../art/"))
  assert_eq(@fs.read_file(responsive_output + "/width.md").text(), @utf8.decode(width_source).replace_all(old="assets/", new="art/"))
  assert_eq(@fs.read_file(responsive_output + "/art/banner.png").binary(), banner)
  assert_eq(@fs.read_file(responsive_output + "/art/banner_dark.png").binary(), dark_banner)
  invoke(prefix + ["restore", responsive_output, responsive_plan, tmp + "/responsive-restored"], 0)
  assert_eq(@fs.read_file(tmp + "/responsive-restored/header.md").text(), responsive_source)
  assert_eq(@fs.read_file(tmp + "/responsive-restored/width.md").binary(), width_source)
  assert_eq(@fs.read_file(tmp + "/responsive-restored/assets/banner.png").binary(), banner)
  assert_eq(@fs.read_file(tmp + "/responsive-restored/assets/banner_dark.png").binary(), dark_banner)
  assert_eq(@fs.read_file("examples/svelte/tree/header.md").text(), responsive_source)
  assert_eq(@fs.read_file("examples/svelte/tree/assets/banner.png").binary(), banner)
  assert_eq(@fs.read_file("examples/svelte/tree/assets/banner_dark.png").binary(), dark_banner)
  println("Responsive image E2E passed: verbatim Svelte header, dark srcset and fallback, saved-plan review/replay/restore, exact PNG bytes.")
  println("Root navigation E2E passed: directory move, saved-plan review/replay/restore, root query/fragment, original fixture bytes and CRLF.")
  println("Restore E2E passed: original paths and bytes, both syntax profiles, stale result refusal, later edits preserved, retry and exclusive output.")
  println("Staged export E2E passed: actual write failure, unpublished final path, retained diagnostics, successful retry and exact asset bytes.")
  println("Static HTML E2E passed: bat header, profile opt-in, saved-plan replay, exact source edit and logo bytes.")
  println("E2E passed: " + target + " (real README relocation, bytes, stale plan, exclusive output, usage). Files retained: " + tmp)
}
