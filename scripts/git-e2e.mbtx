///|
import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/process",
  "moonbitlang/core/env",
}

///|
async fn git(root : String, args : Array[String]) -> String {
  let (code, out, err) = @process.collect_output("git", ["-C", root] + args)
  guard code == 0 else {
    println(err.text())
    abort("Git operation failed")
  }
  out.text().trim().to_owned()
}

///|
async fn capture(args : Array[String], expected : Int32) -> String {
  let (code, out, err) = @process.collect_output("moon", args)
  if code != expected {
    println(out.text())
    println(err.text())
    abort("Unexpected CLI exit")
  }
  out.text().replace_all(old="\r\n", new="\n")
}

///|
async fn diff(
  root : String,
  before : String,
  after : String,
  output : String,
) -> Unit {
  ignore(
    git(root, [
      "diff",
      "--no-ext-diff",
      "--no-textconv",
      "--no-relative",
      "--name-status",
      "-z",
      "-M100%",
      "--output=" + output,
      before,
      after,
      "--",
      "docs",
    ]),
  )
}

///|
async fn main {
  let target = @env.args().last().unwrap_or("wasm")
  guard target == "wasm" || target == "native" else {
    fail("Use wasm or native")
  }
  let tmp = @fs.tmpdir(prefix="mndocmove-git-")
  let repo = tmp + "/repo"
  @fs.mkdir(repo)
  @fs.mkdir(repo + "/docs")
  let root = "examples/vscode/tree"
  let original = @fs.read_file(root + "/README.md").text()
  let asset = @fs.read_file(root + "/example.mjs").binary()
  @fs.write_file(repo + "/docs/README.md", original)
  @fs.write_file(repo + "/docs/example.mjs", asset)
  ignore(git(repo, ["init", "--quiet"]))
  ignore(git(repo, ["config", "core.autocrlf", "false"]))
  ignore(git(repo, ["add", "--", "docs"]))
  // Tree objects need no commit or author identity. The actual repo is untouched.
  let before = git(repo, ["write-tree"])
  @fs.mkdir(repo + "/docs/manual")
  @fs.mkdir(repo + "/docs/samples")
  ignore(git(repo, ["mv", "--", "docs/README.md", "docs/manual/README.md"]))
  ignore(
    git(repo, ["mv", "--", "docs/example.mjs", "docs/samples/example.mjs"]),
  )
  let after = git(repo, ["write-tree"])
  let status = tmp + "/renames.z"
  diff(repo, before, after, status)
  let prefix = [
    "run",
    "cmd/main",
    "--target",
    target,
    "--target-dir",
    tmp + "/build",
    "--deny-warn",
    "--",
  ]
  let plan = tmp + "/plan.json"
  ignore(capture(prefix + ["plan-git", root, status, "docs", plan], 0))
  let saved = @fs.read_file(plan).binary()
  ignore(capture(prefix + ["plan-git", root, status, "docs", plan], 1))
  assert_eq(@fs.read_file(plan).binary(), saved)
  assert_true(
    capture(
      prefix + ["plan-git", root, status, "other", tmp + "/wrong-root.json"],
      1,
    ).contains("GitRootScope"),
  )
  assert_true(!@fs.exists(tmp + "/wrong-root.json"))
  let review = capture(prefix + ["review", plan], 0)
  assert_true(review.contains("[example.mjs](../samples/example.mjs)"))
  let output = tmp + "/export"
  ignore(capture(prefix + ["replay", root, plan, output], 0))
  assert_eq(
    @fs.read_file(output + "/manual/README.md").text(),
    original.replace(
      old="[example.mjs](./example.mjs)",
      new="[example.mjs](../samples/example.mjs)",
    ),
  )
  assert_eq(@fs.read_file(output + "/samples/example.mjs").binary(), asset)
  ignore(capture(prefix + ["check", output, plan, "--result"], 0))
  let restored = tmp + "/restored"
  ignore(capture(prefix + ["restore", output, plan, restored], 0))
  assert_eq(@fs.read_file(restored + "/README.md").text(), original)
  assert_eq(@fs.read_file(restored + "/example.mjs").binary(), asset)
  // The actual git-mv tree has current paths but unchanged old-coordinate URLs.
  let repair = tmp + "/repair.json"
  let current = repo + "/docs"
  // An existing pending plan can prove that these are physical renames ONLY.
  let adoption = tmp + "/adopted.json"
  assert_eq(
    capture(prefix + ["check-renamed", current, plan], 0).trim().to_owned(),
    "[\"mndocmove-check\",1,\"source\",2,2,[]]",
  )
  ignore(capture(prefix + ["adopt", current, plan, adoption], 0))
  let adopted_bytes = @fs.read_file(adoption).binary()
  ignore(capture(prefix + ["adopt", current, plan, adoption], 1))
  assert_eq(@fs.read_file(adoption).binary(), adopted_bytes)
  ignore(
    capture(prefix + ["adopt", current, plan, current + "/inside.json"], 1),
  )
  assert_true(!@fs.exists(current + "/inside.json"))
  let adoption_review = capture(prefix + ["review", adoption], 0)
  assert_true(adoption_review.contains("Verified move adoption"))
  assert_true(adoption_review.contains("Link-only repair"))
  assert_true(!adoption_review.contains("\nmove "))
  let adopted_output = tmp + "/adopted-output"
  ignore(capture(prefix + ["replay", current, adoption, adopted_output], 0))
  assert_eq(
    @fs.read_file(adopted_output + "/manual/README.md").binary(),
    @fs.read_file(output + "/manual/README.md").binary(),
  )
  assert_eq(
    @fs.read_file(adopted_output + "/samples/example.mjs").binary(),
    asset,
  )
  ignore(capture(prefix + ["check", adopted_output, adoption, "--result"], 0))
  let adopted_restore = tmp + "/adopted-restored"
  ignore(
    capture(prefix + ["restore", adopted_output, adoption, adopted_restore], 0),
  )
  assert_eq(
    @fs.read_file(adopted_restore + "/manual/README.md").text(),
    original,
  )
  assert_eq(
    @fs.read_file(adopted_restore + "/samples/example.mjs").binary(),
    asset,
  )
  assert_true(!@fs.exists(adopted_restore + "/README.md"))
  assert_true(
    capture(prefix + ["check-renamed", current, adoption], 1).contains(
      "AdoptPlanKind",
    ),
  )
  ignore(capture(prefix + ["relink-git", current, status, "docs", repair], 0))
  ignore(
    capture(
      prefix +
      [
        "relink",
        current,
        "examples/vscode/moves.json",
        tmp + "/repair-json.json",
      ],
      0,
    ),
  )
  assert_eq(
    @fs.read_file(tmp + "/repair-json.json").binary(),
    @fs.read_file(repair).binary(),
  )
  let evidence = capture(prefix + ["review", repair], 0)
  assert_true(evidence.contains("Link-only repair"))
  assert_true(
    evidence.contains("already-renamed \"README.md\" -> \"manual/README.md\""),
  )
  assert_true(!evidence.contains("\nmove "))
  assert_true(evidence.contains("[example.mjs](../samples/example.mjs)"))
  ignore(capture(prefix + ["check", current, repair], 0))
  let repaired = tmp + "/repaired"
  ignore(capture(prefix + ["replay", current, repair, repaired], 0))
  assert_eq(
    @fs.read_file(repaired + "/manual/README.md").binary(),
    @fs.read_file(output + "/manual/README.md").binary(),
  )
  assert_eq(@fs.read_file(repaired + "/samples/example.mjs").binary(), asset)
  ignore(capture(prefix + ["check", repaired, repair, "--result"], 0))
  let undone = tmp + "/repair-restored"
  ignore(capture(prefix + ["restore", repaired, repair, undone], 0))
  assert_eq(@fs.read_file(undone + "/manual/README.md").text(), original)
  assert_eq(@fs.read_file(undone + "/samples/example.mjs").binary(), asset)
  assert_true(!@fs.exists(undone + "/README.md"))
  @fs.write_file(tmp + "/next-moves.json", "[[\"samples\",\"media\"]]")
  let chain = tmp + "/repair-chain.json"
  ignore(
    capture(
      prefix + ["extend", current, repair, tmp + "/next-moves.json", chain],
      0,
    ),
  )
  ignore(capture(prefix + ["replay", current, chain, tmp + "/chain-export"], 0))
  assert_eq(
    @fs.read_file(tmp + "/chain-export/manual/README.md").text(),
    original.replace(
      old="[example.mjs](./example.mjs)",
      new="[example.mjs](../media/example.mjs)",
    ),
  )
  assert_eq(@fs.read_file(current + "/manual/README.md").text(), original)
  // Unfiltered Git records expose additions/deletions after a content edit.
  @fs.write_file(
    repo + "/docs/manual/README.md",
    "edited content",
    create_mode=TruncateExisting,
  )
  ignore(git(repo, ["add", "--", "docs"]))
  let changed = git(repo, ["write-tree"])
  diff(repo, before, changed, tmp + "/changed.z")
  assert_true(
    capture(
      prefix +
      ["plan-git", root, tmp + "/changed.z", "docs", tmp + "/refused.json"],
      1,
    ).contains("UnsupportedGitChange"),
  )
  assert_true(!@fs.exists(tmp + "/refused.json"))
  let drift = capture(prefix + ["check-renamed", current, plan], 1)
  assert_true(drift.contains("\"modified\",\"manual/README.md\""))
  assert_true(
    capture(
      prefix + ["adopt", current, plan, tmp + "/refused-adoption.json"],
      1,
    ).contains("AdoptionMismatch"),
  )
  assert_true(!@fs.exists(tmp + "/refused-adoption.json"))
  assert_true(
    capture(prefix + ["replay", current, repair, tmp + "/stale-repair"], 1).contains(
      "StaleSnapshot",
    ),
  )
  assert_true(!@fs.exists(tmp + "/stale-repair"))
  assert_eq(
    @fs.read_file(current + "/manual/README.md").text(),
    "edited content",
  )
  assert_eq(@fs.read_file(root + "/README.md").text(), original)
  assert_eq(@fs.read_file(root + "/example.mjs").binary(), asset)
  println(
    "Git rename E2E passed: " +
    target +
    "; real Git -z tree diff without commits, baseline planning, verified adoption and already-moved link repair, review/replay/check/restore, repair chain and stale/content-edit refusal. Files retained: " +
    tmp,
  )
}
